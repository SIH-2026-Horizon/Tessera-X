{
  "name": "tessera-x-tooling",
  "private": true,
  "scripts": {
    "lint": "uv run ruff check .",
    "format:check": "uv run ruff format --check . && prettier --check . --ignore-unknown",
    "format": "uv run ruff format . && prettier --write . --ignore-unknown",
    "test": "uv run pytest",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "prettier": "3.9.7"
  }
}
